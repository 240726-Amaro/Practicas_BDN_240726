{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "title": "DB Test · esquema relacional (BD23)",
    "locale": "es",
    "output": "Practica04/diagrama/db-test-archify.html",
    "quality_profile": "standard",
    "views": [
      {
        "id": "compra",
        "label": "Flujo de compra",
        "focus": [
          "tb_carts",
          "tbd_carts_items",
          "tb_orders",
          "tb_buyer_orders",
          "tbd_order_items"
        ],
        "note": "Carrito → orden (1:1 por cart_ID UNIQUE) → subórdenes por vendedor (order_ID + seller_ID únicos) → líneas."
      },
      {
        "id": "pago",
        "label": "Pago de una orden",
        "focus": [
          "tb_orders",
          "tb_payments",
          "tb_payment_transaction",
          "tbc_payment_methods",
          "tbd_user_payment_methods",
          "tbc_payment_methods_types"
        ],
        "note": "sp_pay_order crea un pago y una transacción por cuota; meses solo con CREDIT_CARD."
      },
      {
        "id": "postventa",
        "label": "Envíos y postventa",
        "focus": [
          "tb_buyer_orders",
          "tb_shipments",
          "tb_returns",
          "tbd_return_items",
          "tb_order_cancellations",
          "tbd_cancellation_items",
          "tb_refunds"
        ],
        "note": "Envíos, devoluciones y cancelaciones cuelgan de la suborden del vendedor."
      },
      {
        "id": "usuarios",
        "label": "Usuarios",
        "focus": [
          "tb_users",
          "tb_people",
          "tb_user_addresses",
          "tbd_address_components",
          "tb_carts"
        ],
        "note": "Un usuario puede tener varios carritos (idx_cart_user ya no es único)."
      }
    ]
  },
  "layout": {
    "mode": "grid",
    "gapX": 64,
    "gapY": 36
  },
