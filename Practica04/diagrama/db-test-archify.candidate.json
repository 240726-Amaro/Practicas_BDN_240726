  "cards": [
    {
      "dot": "cyan",
      "title": "Cambios BD23",
      "items": [
        "tb_orders.cart_ID: NOT NULL, UNIQUE, FK → tb_carts.ID (1:1 carrito-orden).",
        "tb_buyer_orders.order_ID: FK → tb_orders.ID; UNIQUE (order_ID, seller_ID).",
        "tb_carts: uk_cart_user pasa a índice idx_cart_user (varios carritos por usuario).",
        "tb_shipments: nueva columna notes; shipment_status agrega 'Failed attempt' y 'At pickup point'.",
        "Eliminados: tbc_gen_country_profile, tbc_gen_family_names, tbc_gen_given_names."
      ]
    },
    {
      "dot": "amber",
      "title": "Dominios ENUM",
      "items": [
        "tb_buyer_orders.fulfillment_status: Pending, Accepted, Preparing, Sent, Delivered, Canceled, Returned",
        "tb_logs.operation: Create, Read, Update, Delete",
        "tb_order_cancellations.cancellation_status: Requested, Approved, Rejected, Completed",
        "tb_orders.status: Pending, Processing, Shipped, Delivered, Cancelled",
        "tb_payment_transaction.transaction_type: Charge, Refund, Void",
        "tb_payment_transaction.transaction_status: Pending, Completed, Failed",
        "tb_payments.payment_status: Pending, Completed, Failed, Refunded",
        "tb_refunds.refund_status: Pending, Processed, Rejected",
        "tb_returns.return_status: Requested, Approved, Rejected, Received, Refunded",
        "tb_shipments.shipment_status: Preparing, Shipped, In transit, Failed attempt, At pickup point, Delivered, Returned",
        "tbd_products_users_providers.type_ownership: Owner, Reseller, Distributor"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cómo leer",
      "items": [
        "Cada columna del lienzo es un dominio funcional; tb_logs recibe las escrituras de los 75 triggers sin FK.",
        "tbd_products_categories.category_ID no declara FK a tbc_categories, por eso no hay línea entre ambas.",
        "Los ENUM se muestran como enum(n); sus valores están en la tarjeta Dominios ENUM."
      ]
    },
    {
      "dot": "violet",
      "title": "Autorreferencias (sin línea)",
      "items": [
        "tbd_address_components.address_ID, address_sup_ID → tbd_address_components (fk_component_parent): jerarquía en la misma tabla.",
        "tbc_categories.sup_id_category → tbc_categories (fk_superior_category): jerarquía en la misma tabla."
      ]
    }
  ]
}